# Mutfak ayarları
# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun:  cp .env.example .env
# .env dosyası asla git'e eklenmez. Anahtarlarınızı kimseyle paylaşmayın.

# ── Sunucu ─────────────────────────────────────────────
# Panonun yayınlanacağı alan adı. DNS'te bu ad için sunucunun IP'sini
# gösteren bir A kaydı olmalı. Caddy HTTPS sertifikasını kendisi alır.
DOMAIN=mutfak.example.com

# Özel panelin (/panel) giriş şifresi. Uzun ve tahmin edilemez olsun.
PANEL_PASSWORD=

# Oturum çerezlerini imzalamak ve IP adreslerini özetlemek için gizli değer.
# Üretmek için: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── YouTube Data API v3 ────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > API key
# Anahtarı yalnızca "YouTube Data API v3" ile sınırlamanız önerilir.
YOUTUBE_API_KEY=

# Kanal kimliği, "UC" ile başlar. YouTube Studio > Ayarlar > Kanal >
# Gelişmiş ayarlar bölümünde bulunur.
YOUTUBE_CHANNEL_ID=

# ── OpenRouter (analiz) ────────────────────────────────
# https://openrouter.ai/keys adresinden alınır.
OPENROUTER_API_KEY=

# Yorumları analiz edecek model. İstediğiniz OpenRouter modeliyle değiştirebilirsiniz.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# ── Telegram (isteğe bağlı) ────────────────────────────
# Boş bırakılırsa bot kapalı kalır.
# Token: Telegram'da @BotFather ile yeni bot oluşturun.
# Chat ID: kendi Telegram kullanıcı kimliğiniz (bir sayı). Bota bir mesaj atın,
# sonra @userinfobot ile öğrenin. Bot yalnızca bu kimliğe cevap verir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Zamanlama ──────────────────────────────────────────
# Gece toplama ve analiz saati (Europe/Istanbul saatiyle).
RUN_AT=03:00

# Telegram sabah raporunun saati (bot açıksa).
REPORT_AT=09:00
